# ==============================================================================
# GASTRO-ORDER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. SUPABASE CLOUD DATENBANK (https://supabase.com -> Project Settings -> API)
# Ersetze diese Werte durch dein Supabase-Projekt (Region Frankfurt / EU)
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-public-key

# Optional: Service Role Key für administrative Server-Tasks (niemals im Frontend leaken!)
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# 2. MOLLIE PAYMENT GATEWAY (Optional: für zentrale Plattform-Abwicklung)
# Restaurant-Wirte können ihren eigenen Key auch direkt im Admin-Portal hinterlegen
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. BASE URL (für Webhooks und Embed-Skripte)
NEXT_PUBLIC_BASE_URL=https://deine-domain.vercel.app
